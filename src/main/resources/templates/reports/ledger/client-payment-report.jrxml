	<parameter name="coach_id" class="java.lang.Long"/>
	<parameter name="startDate" class="java.util.Date"/>
	<parameter name="endDate" class="java.util.Date"/>
	<parameter name="SUB_REPORT" class="net.sf.jasperreports.engine.JasperReport"/>
	<query language="sql"><![CDATA[SELECT 
    co.first_name AS coach_first_name,
    co.last_name  AS coach_last_name,
    cli_ind.first_name AS client_first_name,
    cli_ind.last_name  AS client_last_name,
    en.created_at AS enrollment_created_at,
    cll.deposit_date AS deposit_date,
    en.session_count AS session_count,
    cll.amount AS payment_amount,
    cll.payment_method AS payment_method,
    en.center_percentage AS center_percentage,
    en.coach_percentage AS coach_percentage,
    CASE 
        WHEN cll.balance > 0 THEN cll.balance 
    END AS credit_balance,
    CASE 
        WHEN cll.balance < 0 THEN cll.balance 
    END AS outstanding_amount,
    CASE
        WHEN cll.balance > 0 AND cll.balance < cll.amount
            THEN (en.center_percentage / 100) * (cll.amount - cll.balance)
        ELSE
            (en.center_percentage / 100) * cll.amount
    END AS center_share,
    CASE
        WHEN cll.balance > 0 AND cll.balance < cll.amount
            THEN (en.coach_percentage / 100) * (cll.amount - cll.balance)
        ELSE
            (en.coach_percentage / 100) * cll.amount
    END AS coach_commission
FROM enrollment en
JOIN individual co ON co.id = en.coach_id
JOIN client cl ON cl.id = en.client_id
JOIN individual cli_ind ON cli_ind.id = cl.id
JOIN clientـledger cll ON cll.enrollment_id = en.id
WHERE cll.deposit_date BETWEEN $P{startDate}
AND $P{endDate}
AND co.id = $P{coach_id}
ORDER BY cl.id,cll.created_at DESC ]]></query>
